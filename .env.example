APP_NAME="ata-energo"
# development | production
APP_ENV=development
APP_BASE_URL=http://localhost:8000
TIME_ZONE=Asia/Bishkek

SERVER_PORT=8000
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s

# ----- Docker (docker compose up) -----
# Порт API на компьютере: http://localhost:8000/api/health
APP_PORT=8000
# Пользователь/пароль/база PostgreSQL в контейнере
POSTGRES_USER=ata
POSTGRES_PASSWORD=ata
POSTGRES_DB=ata_energo
# При запуске контейнера создать тестовые данные (admin/admin123, client1/client123 ...)
SEED_DEMO=true
SEED_CLIENTS=25

# PostgreSQL (для запуска без Docker; в Docker адрес подставляет docker-compose)
DATABASE_URL=postgres://ata:ata@localhost:5432/ata_energo?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Redis (для WebSocket между процессами: сервер + отдельный воркер / несколько экземпляров).
# Пусто — без Redis, всё работает внутри одного процесса.
# Можно "host:port" или "redis://user:pass@host:port/0"
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-very-long-random-secret
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=168h

# ----- MQTT (модемы шлют данные в топик inverter/<SN>/data) -----
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=inverter/+/data

# ----- Поведение -----
# Через сколько секунд без данных устройство считается offline
DEVICE_OFFLINE_TIMEOUT=30
# Демо-режим: сервер сам генерирует фейковые данные (не нужен ни MQTT, ни Redis).
# Для реальных модемов поставьте false!
DEMO_MODE=true
DEMO_INTERVAL=2

# ----- Deye Cloud OpenAPI (https://developer.deyecloud.com/api) -----
DEYE_ENABLED=true
# EU: https://eu1-developer.deyecloud.com   US: https://us1-developer.deyecloud.com
DEYE_BASE_URL=https://eu1-developer.deyecloud.com
# Как часто опрашивать облако (сек). Облако обновляет данные примерно раз в 5 минут.
DEYE_POLL_INTERVAL=60
# Через сколько секунд без данных из облака модем Deye считается offline
DEYE_OFFLINE_TIMEOUT=600
# Необязательно: аккаунт из .env создаётся автоматически при старте
# (аккаунты также можно добавить через API: POST /api/deye/accounts/).
DEYE_APP_ID=
DEYE_APP_SECRET=
# Один из: email, username или mobile (+ код страны)
DEYE_EMAIL=
DEYE_USERNAME=
DEYE_MOBILE=
DEYE_COUNTRY_CODE=
# Пароль аккаунта (в базу пишется только SHA-256)
DEYE_PASSWORD=
# Для бизнес-аккаунта (организации)
DEYE_COMPANY_ID=

# Зашифрованное хранилище облачных аккаунтов. 32 случайных байта в Base64.
PROVIDER_MASTER_KEY=
PROVIDER_KEY_VERSION=1
# Только во время ротации:
PROVIDER_PREVIOUS_MASTER_KEY=
PROVIDER_PREVIOUS_KEY_VERSION=
